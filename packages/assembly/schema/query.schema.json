          "minItems": 2,
          "maxItems": 2
        },
        "determinant": {
          "type": "number",
          "minimum": 0.999999,
          "maximum": 1.000001
        }
      },
      "required": [
        "rotation",
        "translation_m",
        "maps_frame_b_to_a",
        "determinant"
      ],
      "additionalProperties": false
    },
