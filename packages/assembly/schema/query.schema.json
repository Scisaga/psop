{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "psop.assembly.query/1.0-draft.1",
  "title": "Bounded rigid hole-group query proposals with independent four-dimensional assessments",
  "type": "object",
  "properties": {
    "schema": {
      "const": "psop.assembly.query/1.0-draft.1"
    },
    "definition_id": {
      "type": "string",
      "minLength": 1
    },
    "basis": {
      "$ref": "#/$defs/basis"
    },
    "status": {
      "enum": [
        "proposals",
        "unknown",
        "no_solution_in_declared_scope"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "bounded_rigid_hole_group"
        },
        "synthetic": {
          "type": "boolean"
        },
        "axis_relation": {
          "enum": [
            "parallel",
            "opposed",
            "unoriented"
          ]
        }
      },
      "required": [
        "kind",
        "synthetic",
        "axis_relation"
      ],
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "selection_complete": {
          "type": "boolean"
        },
        "stop_reason": {
          "type": "string",
          "minLength": 1
        },
        "mappings_examined": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "complete",
        "selection_complete",
        "stop_reason",
        "mappings_examined"
      ],
      "additionalProperties": false
    },
    "selections": {
      "type": "object",
      "properties": {
        "a": {
          "$ref": "#/$defs/selections"
        },
        "b": {
          "$ref": "#/$defs/selections"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "additionalProperties": false
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposal"
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "definition_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema",
    "definition_id",
    "basis",
    "status",
    "scope",
    "search",
    "selections",
    "proposals",
    "limitations",
    "definition_digest"
  ],
  "additionalProperties": false,
  "$defs": {
    "basis": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "source"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "refs"
      ],
      "additionalProperties": false
    },
    "warrant": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "source_function"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "refs",
        "statement"
      ],
      "additionalProperties": false
    },
    "assessment_input": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "basis_refs"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "reasons"
      ],
      "additionalProperties": false
    },
    "interval": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
