          "minLength": 1
        },
        "mode_a_ref": {
          "type": "string",
          "minLength": 1
        },
        "interface_b_ref": {
          "type": "string",
          "minLength": 1
        },
        "mode_b_ref": {
          "type": "string",
          "minLength": 1
        },
