          "minItems": 0
        },
        "assessments": {
          "type": "object",
          "properties": {
            "engineering": {
              "$ref": "#/$defs/assessment_input"
            },
            "task": {
              "$ref": "#/$defs/assessment_input"
            },
            "path": {
              "$ref": "#/$defs/assessment_input"
            },
            "elastic": {
              "$ref": "#/$defs/assessment_input"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "engagement": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/engagement"
          },
          "minItems": 0
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "selections": {
      "type": "object",
      "properties": {
        "admissible_sets": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "unknown_sets": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "forbidden_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "admissible_sets",
        "unknown_sets",
        "forbidden_count"
      ],
      "additionalProperties": false
    },
    "member_mapping": {
      "type": "object",
      "properties": {
        "role_a": {
          "type": "string",
          "minLength": 1
        },
        "role_b": {
          "type": "string",
          "minLength": 1
        },
        "hole_a_ref": {
          "type": "string",
          "minLength": 1
        },
        "hole_b_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role_a",
        "role_b",
        "hole_a_ref",
        "hole_b_ref"
      ],
      "additionalProperties": false
    },
    "transform": {
      "type": "object",
      "properties": {
        "rotation": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 3,
          "maxItems": 3
        },
        "translation_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "maps_frame_b_to_a": {
          "type": "array",
