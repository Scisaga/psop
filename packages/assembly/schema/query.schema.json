      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "frame_ref": {
          "type": "string",
          "minLength": 1
        },
        "center_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "axis": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "axial_range_m": {
          "$ref": "#/$defs/interval"
        }
      },
      "required": [
        "id",
        "owner_ref",
        "frame_ref",
        "center_m",
        "axis",
        "radius_m",
        "axial_range_m"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "completeness": {
          "enum": [
            "complete",
            "open_unknown"
          ]
        },
        "allowed_sets": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "cardinality": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "anchors_any": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "paired_dependencies": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "required_members": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "dimension": {
          "enum": [
            "mechanical",
            "engineering",
            "task"
          ]
        }
      },
      "required": [
        "completeness"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "role_ref": {
          "type": "string",
          "minLength": 1
        },
        "hole_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role_ref",
        "hole_ref"
      ],
      "additionalProperties": false
    },
    "mode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "$ref": "#/$defs/selection"
        },
        "warrant": {
          "$ref": "#/$defs/warrant"
        },
        "requirements": {
          "type": "object",
          "properties": {
            "connector_role_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "path_required": {
              "type": "boolean"
            },
            "elastic_required": {
              "type": "boolean"
            },
            "completion_policy": {
              "const": "all_selected_paths"
            }
          },
          "required": [
            "connector_role_refs",
            "path_required",
            "elastic_required",
            "completion_policy"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "selection",
        "warrant",
        "requirements"
      ],
      "additionalProperties": false
    },
    "interface": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "owner_ref": {
          "type": "string",
          "minLength": 1
        },
        "frame_ref": {
          "type": "string",
          "minLength": 1
        },
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "complementary_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "minItems": 1
        },
        "warrant": {
          "$ref": "#/$defs/warrant"
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mode"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "owner_ref",
        "frame_ref",
        "mechanism",
        "owner_role",
        "complementary_roles",
        "members",
        "warrant",
        "modes"
      ],
      "additionalProperties": false
    },
    "query_input": {
      "type": "object",
      "properties": {
        "part_a": {
          "type": "string",
          "minLength": 1
        },
        "part_b": {
          "type": "string",
          "minLength": 1
        },
        "interface_a": {
          "type": "string",
          "minLength": 1
        },
        "interface_b": {
          "type": "string",
          "minLength": 1
        },
        "mode_a": {
          "type": "string",
          "minLength": 1
        },
        "mode_b": {
          "type": "string",
          "minLength": 1
        },
        "axis_relation": {
          "enum": [
            "parallel",
            "opposed",
            "unoriented"
          ]
        },
        "position_tolerance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "angle_tolerance_rad": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_members": {
              "type": "integer",
              "minimum": 1
            },
            "max_mappings": {
              "type": "integer",
              "minimum": 1
            },
            "max_proposals": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "max_members",
            "max_mappings",
            "max_proposals"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "part_a",
        "part_b",
        "interface_a",
        "interface_b",
        "mode_a",
        "mode_b",
        "axis_relation",
        "position_tolerance_m",
        "angle_tolerance_rad",
        "limits"
      ],
      "additionalProperties": false
    },
    "participant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "basis_refs"
      ],
      "additionalProperties": false
    },
    "use": {
      "type": "object",
      "properties": {
        "hole_ref": {
          "type": "string",
          "minLength": 1
        },
        "axial_interval_m": {
          "$ref": "#/$defs/interval"
        },
        "sharing_group": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "hole_ref",
        "axial_interval_m"
      ],
      "additionalProperties": false
    },
    "connector_binding": {
      "type": "object",
      "properties": {
        "role_ref": {
          "type": "string",
          "minLength": 1
        },
        "member_pair": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "participant_ref": {
          "type": "string",
          "minLength": 1
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/use"
          },
          "minItems": 0
        }
      },
      "required": [
        "role_ref",
        "member_pair",
        "participant_ref"
      ],
      "additionalProperties": false
    },
    "existing_use": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hole_ref": {
          "type": "string",
          "minLength": 1
        },
        "axial_interval_m": {
          "$ref": "#/$defs/interval"
        },
        "participant_ref": {
          "type": "string",
          "minLength": 1
        },
        "sharing_group": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "hole_ref",
        "axial_interval_m",
        "participant_ref"
      ],
      "additionalProperties": false
    },
    "sharing_rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "common_participant_multilayer",
            "exclusive_intervals"
          ]
        },
        "sharing_group": {
          "type": "string",
          "minLength": 1
        },
        "participant_ref": {
          "type": "string",
          "minLength": 1
        },
        "hole_ref": {
          "type": "string",
          "minLength": 1
        },
        "warrant": {
          "$ref": "#/$defs/warrant"
        }
      },
      "required": [
        "id",
        "kind",
        "warrant"
      ],
      "additionalProperties": false
    },
    "engagement": {
      "type": "object",
      "properties": {
        "member_pair": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "status": {
          "enum": [
            "engaged",
            "not_engaged",
            "unknown"
          ]
        },
        "basis_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "member_pair",
        "status",
        "basis_refs"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "connector_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connector_binding"
