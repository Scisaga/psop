        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "scope": {
          "const": "rigid_group_registration"
        },
        "max_position_residual_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_axis_residual_rad": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "status",
        "scope",
        "max_position_residual_m",
        "max_axis_residual_rad"
      ],
      "additionalProperties": false
    },
    "pose": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "determined"
            },
            "transform": {
              "$ref": "#/$defs/transform"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "transform"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "underdetermined"
            },
            "transform": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "transform"
          ],
          "additionalProperties": false
