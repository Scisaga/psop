            "mechanical": {
              "$ref": "#/$defs/assessment"
            },
            "engineering": {
              "$ref": "#/$defs/assessment"
            },
            "task": {
              "$ref": "#/$defs/assessment"
            },
            "completion": {
              "$ref": "#/$defs/assessment"
