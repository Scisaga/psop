{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"psop.reference-use-review/1",
  "description":"Independently authored source-bound functional interfaces and reference-use requirements; geometric coverage does not imply functional completeness.",
  "type":"object",
  "required":["schema","device_id","date","scope","basis","raw_surface_review_sha256","parts","required_connections","required_surface_regions","surface_pair_dispositions","limits"],
  "properties":{
    "schema":{"const":"psop.reference-use-review/1"},
    "device_id":{"type":"string","minLength":1},
    "date":{"type":"string","minLength":1},
    "scope":{"type":"string","minLength":1},
    "basis":{"type":"string","minLength":1},
    "raw_surface_review_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "parts":{"type":"array","minItems":1,"items":{"type":"object","required":["owner_ref","source_ref","source_sha256","summary","required_interface_refs","interface_dispositions","open_items"],"properties":{
      "owner_ref":{"type":"string","minLength":1},"source_ref":{"type":"string","minLength":1},"source_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"summary":{"type":"string","minLength":1},
      "required_interface_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
      "interface_dispositions":{"type":"array","items":{"type":"object","required":["interface_ref","status","connection_refs"],"properties":{
        "interface_ref":{"type":"string","minLength":1},"status":{"enum":["reference_use_recorded","reference_conflict_recorded","not_observed_used_in_input","use_unresolved"]},
        "connection_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
      },"additionalProperties":false}},
      "open_items":{"type":"array","items":{"type":"string","minLength":1}}
    },"additionalProperties":false}},
    "required_connections":{"type":"array","items":{"type":"object","required":["id","endpoints","mechanism"],"properties":{
      "id":{"type":"string","minLength":1},"mechanism":{"type":"string","minLength":1},
      "endpoints":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","required":["interface_ref","member_refs"],"properties":{"interface_ref":{"type":"string","minLength":1},"member_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}},"additionalProperties":false}}
    },"additionalProperties":false}},
    "required_surface_regions":{"type":"array","items":{"type":"object","required":["interface_ref","owner_ref","triangle_indices","minimum_coverage"],"properties":{
      "interface_ref":{"type":"string","minLength":1},"owner_ref":{"type":"string","minLength":1},"triangle_indices":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"integer","minimum":0}},"minimum_coverage":{"type":"number","exclusiveMinimum":0,"maximum":1}
    },"additionalProperties":false}},
    "surface_pair_dispositions":{"type":"array","items":{"type":"object","required":["owner_refs","status","reason"],"properties":{
      "owner_refs":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"type":"string","minLength":1}},"status":{"enum":["existing_reference_use","added_reference_use","clearance_or_motion_neighbor","unresolved_proxy_contact"]},"reason":{"type":"string","minLength":1},
      "added_connection_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"observation_count":{"type":"integer","minimum":1}
    },"additionalProperties":false}},
    "limits":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  },
  "additionalProperties":false
}
