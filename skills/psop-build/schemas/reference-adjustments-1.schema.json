{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"psop.reference-adjustments/1",
  "type":"object",
  "required":["schema","device_id","title","rationale","maximum_translation_m","numerical_tolerance_m","source_locks","actions","presentation"],
  "properties":{
    "schema":{"const":"psop.reference-adjustments/1"},
    "device_id":{"type":"string","minLength":1},
    "title":{"type":"string","minLength":1},
    "rationale":{"type":"string","minLength":1},
    "maximum_translation_m":{"type":"number"},
    "numerical_tolerance_m":{"type":"number"},
    "source_locks":{"type":"object","additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
    "actions":{"type":"array","minItems":1,"items":{
      "type":"object","required":["id","part_refs","rationale","evidence_refs","constraints"],"additionalProperties":false,
      "properties":{
        "id":{"type":"string","minLength":1},"rationale":{"type":"string","minLength":1},
        "part_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
        "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
        "constraints":{"type":"array","minItems":2,"items":{
          "type":"object","required":["id","role","kind","feature_a_ref","feature_b_ref"],"additionalProperties":false,
          "properties":{
            "id":{"type":"string","minLength":1},"role":{"enum":["repair","neighbor"]},
            "kind":{"enum":["plane_contact","axis_alignment","cylindrical_fit"]},
            "feature_a_ref":{"type":"string"},"feature_b_ref":{"type":"string"},
            "target_gap_m":{"type":"number"},"minimum_overlap_area_m2":{"type":"number"},
            "maximum_axis_distance_m":{"type":"number"},"maximum_angle_rad":{"type":"number"},
            "minimum_axial_overlap_m":{"type":"number"},"maximum_axial_gap_m":{"type":"number"},
            "minimum_radial_clearance_m":{"type":"number"}
          }
        }}
      }
    }},
    "presentation":{"type":"object","required":["part_notes","interfaces","connections"],"additionalProperties":false,
      "properties":{
        "part_notes":{"type":"array","items":{"type":"object","required":["owner_ref","text"],"properties":{"owner_ref":{"type":"string"},"text":{"type":"string"}},"additionalProperties":false}},
        "interfaces":{"type":"array","items":{"type":"object","required":["interface_ref","note","geometry_summary"],"properties":{"interface_ref":{"type":"string"},"note":{"type":"string"},"geometry_summary":{"type":"string"}},"additionalProperties":false}},
        "connections":{"type":"array","items":{"type":"object","required":["connection_ref","note","check_refs"],"properties":{"connection_ref":{"type":"string"},"note":{"type":"string"},"check_refs":{"type":"array","minItems":1,"items":{"type":"string"}},"basis":{"const":"inferred_fit"}},"additionalProperties":false}}
      }
    }
  },
  "additionalProperties":false
}
