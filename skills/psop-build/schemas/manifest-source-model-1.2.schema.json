{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "psop.dkp/2.0-draft.1/source-model-1.2",
  "title": "PSOP v2 data-only finite cylinder and surface interface analysis package",
  "type": "object",
  "properties": {
    "schema": {
      "const": "psop.dkp/2.0-draft.1"
    },
    "profile": {
      "const": "psop.hardware.source-model/1.2"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^psop\\.[a-z][a-z0-9-]{1,63}$"
    },
    "package_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9][A-Za-z0-9.+-]{0,95}$"
    },
    "device": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "ontology": {
      "type": "object",
      "properties": {
        "id": {
          "const": "psop.hardware"
        },
        "version": {
          "const": "psop.hardware/2.0-draft.4"
        },
        "path": {
          "const": "sources/SRC-PSOP-ONTOLOGY.md"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "properties": {
        "id": {
          "const": "microduck-mjcf/1.0"
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{40}$"
        },
        "xml_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "commit",
        "xml_sha256"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "archive": {
          "type": "object",
          "properties": {
            "path": {
              "const": "inputs/materials.zip"
            },
            "sha256": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "archive"
      ],
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "name": {
          "const": "psop-build"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[0-9][A-Za-z0-9.+-]{0,95}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "entrypoints": {
      "type": "object",
      "properties": {
        "knowledge": {
          "const": "knowledge/entities.json"
        },
        "sources": {
          "const": "knowledge/sources.json"
        },
        "evidence": {
          "const": "knowledge/evidence.json"
        },
        "gaps": {
          "const": "knowledge/gaps.json"
        },
        "scene": {
          "const": "indexes/scene.json"
        }
      },
      "required": [
        "knowledge",
        "sources",
        "evidence",
        "gaps",
        "scene"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "integer",
          "minimum": 0
        },
        "geometries": {
          "type": "integer",
          "minimum": 0
        },
        "parts": {
          "type": "integer",
          "minimum": 0
        },
        "bodies": {
          "type": "integer",
          "minimum": 0
        },
        "joints": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "sources",
        "geometries",
        "parts",
        "bodies",
        "joints",
        "evidence"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "source_registry": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "source_model_projection": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "hardware_knowledge": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "mechanical_validation": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "engineering_validation": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "path_validation": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "training_data": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "complete",
                "partial",
                "unavailable"
              ]
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "interface_analysis": {
          "type": "object",
          "properties": {
            "status": {
              "const": "partial"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        },
        "connection_candidates": {
          "type": "object",
          "properties": {
            "status": {
              "const": "partial"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "scope"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "source_registry",
        "source_model_projection",
        "hardware_knowledge",
        "mechanical_validation",
        "engineering_validation",
        "path_validation",
        "training_data",
        "interface_analysis",
        "connection_candidates"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1200
    },
    "package_digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema",
    "profile",
    "package_id",
    "package_version",
    "device",
    "created_at",
    "ontology",
    "adapter",
    "inputs",
    "toolchain",
    "entrypoints",
    "counts",
    "capabilities",
    "files",
    "package_digest"
  ],
  "additionalProperties": false
}
