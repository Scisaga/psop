{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "psop.dkp.manifest/source-model-1.15",
  "title": "Frozen part capabilities and complete local-geometry candidate screening",
  "type": "object",
  "properties": {
    "schema": {
      "const": "psop.dkp/2.0-draft.1"
    },
    "profile": {
      "const": "psop.hardware.source-model/1.15"
    },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^psop\\.[a-z][a-z0-9-]{1,63}$"
    },
    "package_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9][A-Za-z0-9.+-]{0,95}$"
    },
    "device": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "ontology": {
      "type": "object",
      "properties": {
        "id": {
          "const": "psop.hardware"
        },
        "version": {
          "const": "psop.hardware/2.0-draft.4"
        },
        "path": {
          "const": "sources/SRC-PSOP-ONTOLOGY.md"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "properties": {
        "id": {
          "const": "microduck-mjcf/1.0"
        },
        "commit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{40}$"
        },
        "xml_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "commit",
        "xml_sha256"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "archive": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "assembly_knowledge": {
          "type": "object",
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "required": ["path", "sha256"],
          "additionalProperties": false
        },
        "requirements": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "archive",
        "requirements"
      ],
      "additionalProperties": {
        "type": "object",
        "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
        "required": ["path", "sha256"],
        "additionalProperties": false
      }
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "name": {
          "const": "psop-build"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[0-9][A-Za-z0-9.+-]{0,95}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "entrypoints": {
      "type": "object",
      "properties": {
        "reference_alignment": {"const":"indexes/reference-alignment.json"},
        "knowledge": {
          "const": "knowledge/entities.json"
        },
        "sources": {
          "const": "knowledge/sources.json"
        },
        "evidence": {
          "const": "knowledge/evidence.json"
        },
        "gaps": {
          "const": "knowledge/gaps.json"
        },
        "scene": {
          "const": "indexes/scene.json"
        },
        "capabilities": {
          "const": "indexes/capabilities.json"
        },
        "compatibility": {
          "const": "indexes/compatibility.json"
        },
        "coverage": {
          "const": "indexes/coverage.json"
        }
      },
      "required": [
        "knowledge",
        "sources",
        "evidence",
        "gaps",
        "scene",
        "capabilities",
        "compatibility",
        "coverage"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "status",
          "scope"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 20000
    },
    "package_digest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-f0-9]{64}$"
    },
    "freeze": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "requirements_sha256": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "digest",
        "requirements_sha256"
      ],
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "required": [
    "schema",
    "profile",
    "package_id",
    "package_version",
    "device",
    "created_at",
    "ontology",
    "adapter",
    "inputs",
    "toolchain",
    "entrypoints",
    "counts",
    "capabilities",
    "files",
    "package_digest",
    "freeze",
    "performance"
  ],
  "additionalProperties": false
}
