{
  "name": "psop-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs --dev",
    "build": "tsc -b && vite build",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "prepare:workspace": "python -B scripts/prepare_workspace.py",
    "test:api": "node --test scripts/workspaces.test.mjs",
    "test:validation-cache": "node --test scripts/validation-cache.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "lucide-react": "1.68.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
