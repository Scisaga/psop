  "findings": [
    {
      "layer": "source_geometry",
      "conclusion": "The counterbore lips of the Z-directed right-shell site and hip site retain visibly irregular triangular source intersections even with all overlays hidden; STL is closed manifold at 10 nm adjacency, so an open-edge repair is not justified."
    },
    {
      "layer": "display_normals",
      "conclusion": "Existing 35 degree edge-connected angle-weighted normals improve cylinder shading but do not remove the actual irregular lip. Trials at 60/85 degrees and area weighting did not fix it; 85 degrees introduced stretched highlights. No normal-policy change was retained."
    },
    {
      "layer": "source_triangle_patches",
      "conclusion": "Inspected the 144-face Y-bore patch, 180-face Z-bore patch, 98-face outer step patch and hip finite planar patch. Filled source triangles have polygonOffset -2/-2, depthTest true, depthWrite false and wireframe false. They do not draw a crown of triangle edges."
    },
    {
      "layer": "boundaries",
      "conclusion": "Coplanar native WebGL boundary lines lose partial coverage against their own source faces. A bounded 2 micrometre projected-depth offset improves continuity and preserves meaningful occlusion. Coordinates, source geometry and source-facet order are unchanged."
    },
    {
      "layer": "shadow_and_msaa",
      "conclusion": "Turning off receiving shadows or changing normalBias did not remove the source lip crown. Context antialias is enabled with 4 samples at device pixel ratio 1 in the captures."
    }
  ],
